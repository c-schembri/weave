cmake_minimum_required(VERSION 3.25)

set(generator -G "${WEAVE_GENERATOR}")
if(WEAVE_PLATFORM)
  list(APPEND generator -A "${WEAVE_PLATFORM}")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(work "${WEAVE_WORK}/${run_id}")
file(MAKE_DIRECTORY "${work}/project/changes")
file(WRITE "${work}/project/CMakeLists.txt" "cmake_minimum_required(VERSION 3.25)\nproject(manifest_test LANGUAGES CXX)\nset(WEAVE_MODULES database CACHE STRING \"\" FORCE)\nset(WEAVE_BUILD_TESTS OFF CACHE BOOL \"\" FORCE)\nset(WEAVE_BUILD_EXAMPLES OFF CACHE BOOL \"\" FORCE)\nset(WEAVE_BUILD_BENCHMARKS OFF CACHE BOOL \"\" FORCE)\nadd_subdirectory(\"${WEAVE_SOURCE}\" weave)\nadd_executable(probe main.cpp)\nweave_add_migrations(TARGET probe DIRECTORY \"\${CMAKE_CURRENT_SOURCE_DIR}/changes\" NAME manifest)\n")
file(WRITE "${work}/project/main.cpp" "#include \"manifest.hpp\"\n#include <weave/database/detail/migration_plan.hpp>\n#include <cstdlib>\nint main(int argc, char **argv) { auto entries = manifest(); if(argc != 2 || entries.size() != static_cast<unsigned>(std::atoi(argv[1]))) return 1; return weave::db::detail::validate_manifest(entries) ? 0 : 1; }\n")

function(migration filename function version name)
  file(WRITE "${work}/project/changes/${filename}" "#include <weave/database/migrations.hpp>\nweave::db::Migration ${function}() { return weave::db::migration(${version}, \"${name}\", weave::db::schema::drop_table(\"item\")); }\n")
endfunction()

function(run)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 60)
  if(NOT result STREQUAL "0")
    message(FATAL_ERROR "Generator check failed (${result}): ${ARGV}\n${output}\n${error}")
  endif()
endfunction()

function(configure directory expected)
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${work}/project" -B "${work}/${directory}" ${generator}
    "-DCMAKE_CXX_COMPILER=${WEAVE_CXX_COMPILER}" "-DCMAKE_BUILD_TYPE=${WEAVE_CONFIG}"
    -DCMAKE_DISABLE_FIND_PACKAGE_Python3=TRUE -DFETCHCONTENT_FULLY_DISCONNECTED=ON
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
  if(expected STREQUAL "pass")
    if(NOT result STREQUAL "0")
      message(FATAL_ERROR "Generator configuration failed: ${output}\n${error}")
    endif()
  elseif(result STREQUAL "0" OR NOT "${output}${error}" MATCHES "${expected}")
    message(FATAL_ERROR "Generator did not reject ${directory}: ${output}\n${error}")
  endif()
endfunction()

function(probe count)
  run("${CMAKE_COMMAND}" --build "${work}/valid" --config "${WEAVE_CONFIG}" --parallel 2)
  if(EXISTS "${work}/valid/${WEAVE_CONFIG}/probe${CMAKE_EXECUTABLE_SUFFIX}")
    set(executable "${work}/valid/${WEAVE_CONFIG}/probe${CMAKE_EXECUTABLE_SUFFIX}")
  else()
    set(executable "${work}/valid/probe${CMAKE_EXECUTABLE_SUFFIX}")
  endif()
  run("${executable}" "${count}")
endfunction()

if(WIN32)
  set(CMAKE_EXECUTABLE_SUFFIX .exe)
endif()
migration(001_first.cpp migration_001 1 first)
migration(2_second.cpp migration_2 2 second)
migration(10_tenth.cpp migration_10 10 tenth)
configure(valid pass)
probe(3)
file(TIMESTAMP "${work}/valid/weave-migrations/probe/manifest/manifest.cpp" before "%s")
run("${CMAKE_COMMAND}" -E sleep 1)
configure(valid pass)
file(TIMESTAMP "${work}/valid/weave-migrations/probe/manifest/manifest.cpp" after "%s")
if(NOT before STREQUAL after)
  message(FATAL_ERROR "Unchanged migration contents rewrote the generated manifest")
endif()
migration(03_third.cpp migration_03 3 third)
probe(4)
file(REMOVE "${work}/project/changes/03_third.cpp")
probe(3)

migration(01_duplicate.cpp migration_01 1 duplicate)
configure(duplicate "duplicate migration version")
file(REMOVE "${work}/project/changes/01_duplicate.cpp")
migration(000_zero.cpp migration_000 0 zero)
configure(zero "Zero or duplicate")
file(REMOVE "${work}/project/changes/000_zero.cpp")
migration(bad.cpp migration_bad 4 bad)
configure(malformed "Malformed migration filename")
file(REMOVE "${work}/project/changes/bad.cpp")
migration(9223372036854775808_large.cpp migration_large 4 large)
configure(overflow "exceeds signed 64-bit")
file(REMOVE "${work}/project/changes/9223372036854775808_large.cpp")

# A return-type mismatch could otherwise link successfully with an incompatible C++ ABI.
file(WRITE "${work}/project/changes/001_first.cpp" "int migration_001() { return 1; }\n")
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${work}/valid" --config "${WEAVE_CONFIG}" --parallel 2
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 60)
if(result STREQUAL "0")
  message(FATAL_ERROR "Generator accepted a mismatched migration function return type")
endif()
message(STATUS "Migration generator: numeric sorting, metadata, regeneration, validation and ABI checks passed")
