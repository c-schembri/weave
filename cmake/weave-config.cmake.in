@PACKAGE_INIT@

set(weave_AVAILABLE_COMPONENTS "@WEAVE_ENABLED_MODULES@")
if(NOT weave_FIND_COMPONENTS)
  set(weave_FIND_COMPONENTS ${weave_AVAILABLE_COMPONENTS})
endif()

set(_weave_needed "")
foreach(_weave_component IN LISTS weave_FIND_COMPONENTS)
  if(NOT _weave_component IN_LIST weave_AVAILABLE_COMPONENTS)
    set(weave_${_weave_component}_FOUND FALSE)
    if(weave_FIND_REQUIRED_${_weave_component})
      set(weave_NOT_FOUND_MESSAGE "Weave component '${_weave_component}' is not installed. Available: ${weave_AVAILABLE_COMPONENTS}")
    endif()
    continue()
  endif()
  set(weave_${_weave_component}_FOUND TRUE)
  list(APPEND _weave_needed ${_weave_component} core)
  if(_weave_component STREQUAL "runtime" OR _weave_component STREQUAL "tcp")
    list(APPEND _weave_needed io)
  endif()
endforeach()

foreach(_weave_component IN ITEMS core io runtime tcp)
  if(_weave_component IN_LIST _weave_needed AND NOT TARGET weave::${_weave_component})
    include("${CMAKE_CURRENT_LIST_DIR}/weave-${_weave_component}-targets.cmake")
  endif()
endforeach()
check_required_components(weave)
unset(_weave_needed)
unset(_weave_component)
