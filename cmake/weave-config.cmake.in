@PACKAGE_INIT@

set(weave_AVAILABLE_COMPONENTS "@WEAVE_ENABLED_MODULES@")
if(NOT weave_FIND_COMPONENTS)
  set(weave_FIND_COMPONENTS ${weave_AVAILABLE_COMPONENTS})
endif()

set(_weave_needed "")
foreach(_weave_component IN LISTS weave_FIND_COMPONENTS)
  if(NOT _weave_component IN_LIST weave_AVAILABLE_COMPONENTS)
    set(weave_${_weave_component}_FOUND FALSE)
    if(weave_FIND_REQUIRED_${_weave_component})
      set(weave_NOT_FOUND_MESSAGE "Weave component '${_weave_component}' is not installed. Available: ${weave_AVAILABLE_COMPONENTS}")
    endif()
    continue()
  endif()
  set(weave_${_weave_component}_FOUND TRUE)
  list(APPEND _weave_needed ${_weave_component} core)
  if(_weave_component MATCHES "^(runtime|tcp|local|sync|tls|postgres)$")
    list(APPEND _weave_needed io)
  endif()
  if(_weave_component MATCHES "^(tls|postgres)$")
    list(APPEND _weave_needed tcp sync)
  endif()
  if(_weave_component STREQUAL "postgres")
    list(APPEND _weave_needed tls local)
  endif()
endforeach()

if("tls" IN_LIST _weave_needed)
  include(CMakeFindDependencyMacro)
  find_dependency(OpenSSL 3.5 COMPONENTS SSL Crypto)
endif()

if("postgres" IN_LIST _weave_needed)
  include(CMakeFindDependencyMacro)
  find_dependency(ICU 70 COMPONENTS uc i18n)
  if("@CMAKE_SYSTEM_NAME@" STREQUAL "Linux" AND "@WEAVE_POSTGRES_LDAP@")
    set(_weave_module_path "${CMAKE_MODULE_PATH}")
    list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
    find_package(WeaveLDAP QUIET)
    set(CMAKE_MODULE_PATH "${_weave_module_path}")
    unset(_weave_module_path)
    if(NOT WeaveLDAP_FOUND)
      set(weave_FOUND FALSE)
      set(weave_NOT_FOUND_MESSAGE "PostgreSQL LDAP support requires OpenLDAP headers and library")
      return()
    endif()
  endif()
  if("@CMAKE_SYSTEM_NAME@" STREQUAL "Linux" AND "@WEAVE_POSTGRES_GSSAPI@")
    find_dependency(PkgConfig)
    pkg_check_modules(WEAVE_GSSAPI REQUIRED IMPORTED_TARGET krb5-gssapi)
    pkg_check_modules(WEAVE_KERBEROS REQUIRED IMPORTED_TARGET krb5)
  endif()
endif()

if("io" IN_LIST _weave_needed AND "@CMAKE_SYSTEM_NAME@" STREQUAL "Linux")
  include(CMakeFindDependencyMacro)
  find_dependency(PkgConfig)
  pkg_check_modules(LIBURING REQUIRED IMPORTED_TARGET liburing>=2.3)
  find_dependency(Threads)
endif()

foreach(_weave_component IN ITEMS core io runtime tcp local sync tls postgres)
  if(_weave_component IN_LIST _weave_needed AND NOT TARGET weave::${_weave_component})
    include("${CMAKE_CURRENT_LIST_DIR}/weave-${_weave_component}-targets.cmake")
  endif()
endforeach()
check_required_components(weave)
unset(_weave_needed)
unset(_weave_component)
