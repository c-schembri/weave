include_guard(GLOBAL)

# Migration registration is a configure-time operation, with no interpreter or database dependency.
function(weave_add_migrations)
  cmake_parse_arguments(PARSE_ARGV 0 migration "" "TARGET;DIRECTORY;NAME" "")
  if(migration_UNPARSED_ARGUMENTS OR migration_KEYWORDS_MISSING_VALUES OR
      NOT migration_TARGET OR NOT migration_DIRECTORY OR NOT migration_NAME)
    message(FATAL_ERROR "weave_add_migrations requires TARGET, DIRECTORY and NAME")
  endif()
  if(NOT TARGET "${migration_TARGET}")
    message(FATAL_ERROR "Unknown migration target: ${migration_TARGET}")
  endif()
  get_target_property(imported "${migration_TARGET}" IMPORTED)
  get_target_property(alias "${migration_TARGET}" ALIASED_TARGET)
  if(imported OR alias)
    message(FATAL_ERROR "Migration TARGET must be a local, non-alias build target")
  endif()
  if(NOT migration_NAME MATCHES "^[A-Za-z_][A-Za-z0-9_]*$" OR migration_NAME MATCHES "^_|__")
    message(FATAL_ERROR "Migration NAME must be a non-reserved C++ identifier")
  endif()
  get_filename_component(directory "${migration_DIRECTORY}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
  if(NOT IS_DIRECTORY "${directory}")
    message(FATAL_ERROR "Migration directory does not exist: ${directory}")
  endif()
  get_target_property(registered "${migration_TARGET}" WEAVE_MIGRATION_MANIFESTS)
  if(migration_NAME IN_LIST registered)
    message(FATAL_ERROR "Migration manifest already registered: ${migration_NAME}")
  endif()
  set_property(TARGET "${migration_TARGET}" APPEND PROPERTY WEAVE_MIGRATION_MANIFESTS "${migration_NAME}")

  file(GLOB sources CONFIGURE_DEPENDS LIST_DIRECTORIES FALSE "${directory}/*.cpp")
  set(ordered)
  set(versions)
  foreach(source IN LISTS sources)
    get_filename_component(filename "${source}" NAME)
    if(NOT filename MATCHES "^([0-9]+)_([a-z][a-z0-9_]*)[.]cpp$")
      message(FATAL_ERROR "Malformed migration filename: ${filename}; expected <version>_<name>.cpp")
    endif()
    set(digits "${CMAKE_MATCH_1}")
    string(REGEX REPLACE "^0+" "" version "${digits}")
    if(version STREQUAL "" OR version IN_LIST versions)
      message(FATAL_ERROR "Zero or duplicate migration version: ${filename}")
    endif()
    string(LENGTH "${version}" length)
    if(length GREATER 19 OR (length EQUAL 19 AND version STRGREATER "9223372036854775807"))
      message(FATAL_ERROR "Migration version exceeds signed 64-bit history storage: ${filename}")
    endif()
    list(APPEND versions "${version}")
    # Natural sorting treats differently padded numbers inconsistently. Normalize first.
    math(EXPR padding "19 - ${length}")
    string(REPEAT "0" ${padding} zeroes)
    list(APPEND ordered "${zeroes}${version}|${filename}")
  endforeach()
  list(SORT ordered)
  list(LENGTH ordered count)
  set(header "#pragma once\n\n#include <weave/database/migrations.hpp>\n#include <array>\n\nstd::array<weave::db::Migration, ${count}> ${migration_NAME}();\n")
  set(body "#include \"${migration_NAME}.hpp\"\n#include <weave/database/detail/migration_manifest.hpp>\n\n")
  set(entries)
  foreach(record IN LISTS ordered)
    string(REGEX REPLACE "^[0-9]+[|]" "" filename "${record}")
    string(REGEX MATCH "^([0-9]+)_([a-z][a-z0-9_]*)[.]cpp$" matched "${filename}")
    set(digits "${CMAKE_MATCH_1}")
    set(name "${CMAKE_MATCH_2}")
    string(REGEX REPLACE "^0+" "" version "${digits}")
    string(APPEND header "weave::db::Migration migration_${digits}();\n")
    list(APPEND entries "  weave::db::detail::manifest_entry(migration_${digits}(), ${version}, \"${name}\")")
  endforeach()
  list(JOIN entries ",\n" calls)
  string(APPEND body "\nstd::array<weave::db::Migration, ${count}> ${migration_NAME}()\n{\n  return {\n${calls}\n  };\n}\n")
  set(output "${CMAKE_CURRENT_BINARY_DIR}/weave-migrations/${migration_TARGET}/${migration_NAME}")
  file(MAKE_DIRECTORY "${output}")
  # configure_file preserves timestamps when generated contents have not changed.
  set(content "${header}")
  configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/migration_manifest.in" "${output}/${migration_NAME}.hpp" @ONLY)
  set(content "${body}")
  configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/migration_manifest.in" "${output}/${migration_NAME}.cpp" @ONLY)
  # Verify each definition against its generated declaration; a wrong return type is not reliably a linker error.
  foreach(source IN LISTS sources)
    if(MSVC)
      set(include_option "/FI${output}/${migration_NAME}.hpp")
    else()
      set(include_option "-include;${output}/${migration_NAME}.hpp")
    endif()
    set_property(SOURCE "${source}" TARGET_DIRECTORY "${migration_TARGET}" APPEND PROPERTY COMPILE_OPTIONS "${include_option}")
  endforeach()
  target_sources("${migration_TARGET}" PRIVATE ${sources} "${output}/${migration_NAME}.cpp")
  target_include_directories("${migration_TARGET}" PRIVATE "${output}")
  target_link_libraries("${migration_TARGET}" PRIVATE weave::database)
endfunction()
