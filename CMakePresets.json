{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows",
      "displayName": "Windows x64 (Visual Studio 2022)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows",
      "cacheVariables": {
        "WEAVE_MODULES": "core;io;runtime;tcp;local;sync",
        "WEAVE_BUILD_TESTS": "ON",
        "WEAVE_BUILD_BENCHMARKS": "ON",
        "WEAVE_BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "windows-ci",
      "displayName": "Windows correctness tests (no benchmarks)",
      "inherits": "windows",
      "binaryDir": "${sourceDir}/build/windows-ci",
      "cacheVariables": {
        "WEAVE_BUILD_TESTS": "ON",
        "WEAVE_BUILD_BENCHMARKS": "OFF",
        "WEAVE_BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "windows-tls",
      "displayName": "Windows correctness tests including optional TLS",
      "inherits": "windows-ci",
      "binaryDir": "${sourceDir}/build/windows-tls",
      "cacheVariables": {
        "WEAVE_MODULES": "core;io;runtime;tcp;local;sync;tls"
      }
    },
    {
      "name": "windows-postgres",
      "displayName": "Windows correctness tests including TLS and native PostgreSQL",
      "inherits": "windows-tls",
      "binaryDir": "${sourceDir}/build/windows-postgres",
      "cacheVariables": {
        "WEAVE_MODULES": "core;io;runtime;tcp;local;sync;tls;postgres",
        "WEAVE_POSTGRES_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "asan-postgres",
      "inherits": "windows-postgres",
      "binaryDir": "${sourceDir}/build/asan-postgres",
      "cacheVariables": {"WEAVE_ENABLE_ASAN": "ON"}
    },
    {
      "name": "asan-tls",
      "inherits": "windows-tls",
      "binaryDir": "${sourceDir}/build/asan-tls",
      "cacheVariables": {
        "WEAVE_ENABLE_ASAN": "ON"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux io_uring correctness tests including TLS",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "WEAVE_MODULES": "core;io;runtime;tcp;local;sync;tls",
        "WEAVE_BUILD_TESTS": "ON",
        "WEAVE_BUILD_BENCHMARKS": "OFF",
        "WEAVE_BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "linux-release",
      "inherits": "linux-debug",
      "binaryDir": "${sourceDir}/build/linux-release",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}
    },
    {
      "name": "linux-asan",
      "inherits": "linux-debug",
      "binaryDir": "${sourceDir}/build/linux-asan",
      "cacheVariables": {"WEAVE_ENABLE_ASAN": "ON"}
    },
    {
      "name": "windows-runtime-bench",
      "displayName": "Windows local runtime scaling comparison",
      "inherits": "windows",
      "binaryDir": "${sourceDir}/build/windows-runtime-bench",
      "cacheVariables": {
        "WEAVE_BUILD_TESTS": "OFF",
        "WEAVE_BUILD_EXAMPLES": "OFF",
        "WEAVE_BUILD_BENCHMARKS": "ON",
        "WEAVE_BENCHMARK_SUITE": "runtime",
        "WEAVE_ENABLE_ASAN": "OFF",
        "WEAVE_PROFILE_RUNTIME": "OFF",
        "WEAVE_TRACE_RUNTIME": "OFF"
      }
    },
    {
      "name": "asan",
      "inherits": "windows",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "WEAVE_ENABLE_ASAN": "ON",
        "WEAVE_BUILD_BENCHMARKS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {"name": "linux-debug", "configurePreset": "linux-debug"},
    {"name": "linux-release", "configurePreset": "linux-release"},
    {"name": "linux-asan", "configurePreset": "linux-asan"},
    {"name": "debug", "configurePreset": "windows", "configuration": "Debug"},
    {"name": "release", "configurePreset": "windows", "configuration": "Release"},
    {"name": "ci-debug", "configurePreset": "windows-ci", "configuration": "Debug"},
    {"name": "ci-release", "configurePreset": "windows-ci", "configuration": "Release"},
    {"name": "tls-debug", "configurePreset": "windows-tls", "configuration": "Debug"},
    {"name": "tls-release", "configurePreset": "windows-tls", "configuration": "Release"},
    {"name": "postgres-debug", "configurePreset": "windows-postgres", "configuration": "Debug"},
    {"name": "postgres-release", "configurePreset": "windows-postgres", "configuration": "Release"},
    {"name": "asan-postgres", "configurePreset": "asan-postgres", "configuration": "Release"},
    {"name": "asan-tls", "configurePreset": "asan-tls", "configuration": "Release"},
    {"name": "runtime-bench", "configurePreset": "windows-runtime-bench", "configuration": "Release"},
    {"name": "asan", "configurePreset": "asan", "configuration": "Release"}
  ],
  "testPresets": [
    {"name": "linux-debug", "configurePreset": "linux-debug", "output": {"outputOnFailure": true}},
    {"name": "linux-release", "configurePreset": "linux-release", "output": {"outputOnFailure": true}},
    {"name": "linux-asan", "configurePreset": "linux-asan", "output": {"outputOnFailure": true}},
    {"name": "debug", "configurePreset": "windows", "configuration": "Debug", "output": {"outputOnFailure": true}},
    {"name": "release", "configurePreset": "windows", "configuration": "Release", "output": {"outputOnFailure": true}},
    {"name": "ci-debug", "configurePreset": "windows-ci", "configuration": "Debug", "output": {"outputOnFailure": true}, "filter": {"exclude": {"label": "benchmark"}}},
    {"name": "ci-release", "configurePreset": "windows-ci", "configuration": "Release", "output": {"outputOnFailure": true}, "filter": {"exclude": {"label": "benchmark"}}},
    {"name": "tls-debug", "configurePreset": "windows-tls", "configuration": "Debug", "output": {"outputOnFailure": true}},
    {"name": "tls-release", "configurePreset": "windows-tls", "configuration": "Release", "output": {"outputOnFailure": true}},
    {"name": "postgres-debug", "configurePreset": "windows-postgres", "configuration": "Debug", "output": {"outputOnFailure": true}},
    {"name": "postgres-release", "configurePreset": "windows-postgres", "configuration": "Release", "output": {"outputOnFailure": true}},
    {"name": "asan-postgres", "configurePreset": "asan-postgres", "configuration": "Release", "output": {"outputOnFailure": true}},
    {"name": "asan-tls", "configurePreset": "asan-tls", "configuration": "Release", "output": {"outputOnFailure": true}},
    {"name": "asan", "configurePreset": "asan", "configuration": "Release", "output": {"outputOnFailure": true}}
  ]
}
